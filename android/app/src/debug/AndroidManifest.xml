<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILDS ONLY. Merged into the debug manifest and absent from release.

  Lets scripts/e2e-rules.sh set the driver's rules from adb, so the emulator
  scenario test can run a table of rule sets without anybody tapping the rules
  screen. Guarded by DUMP, which adb's shell holds and an ordinary app can never
  be granted, so nothing else on the device can rewrite the rules through it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <receiver
            android:name=".debug.E2eRulesReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="jo.autofare.debug.SET_RULES" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
