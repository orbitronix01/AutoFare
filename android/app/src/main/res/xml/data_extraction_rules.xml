<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing leaves this phone through backup or phone-to-phone transfer.
    allowBackup="false" alone does not stop Android 12+ device transfer, and a
    transferred licence or capture folder is exactly what must not move.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
